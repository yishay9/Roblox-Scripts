-- 13. TELEPORT EXECUTION LOGIC
executeButton.MouseButton1Click:Connect(function()
    local inputText = textBox.Text
    inputText = inputText:gsub("[%[%]]", "")
    
    local numbers = {}
    for num in inputText:gmatch("[^,%s]+") do
        table.insert(numbers, tonumber(num))
    end
    
    if #numbers == 3 or #numbers == 12 then
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            local targetCFrame
            if #numbers == 3 then
                targetCFrame = CFrame.new(numbers[1], numbers[2], numbers[3])
            elseif #numbers == 12 then
                targetCFrame = CFrame.new(
                    numbers[1], numbers[2], numbers[3],
                    numbers[4], numbers[5], numbers[6],
                    numbers[7], numbers[8], numbers[9],
                    numbers[10], numbers[11], numbers[12]
                )
            end
            
            character:PivotTo(targetCFrame)
            
            executeButton.BackgroundColor3 = COLORS.Green
            executeButton.Text = "Teleported Successfully!"
            statusLabel.Text = "✓ Teleported character to target"
            statusLabel.TextColor3 = COLORS.Green
            task.wait(1)
            executeButton.BackgroundColor3 = COLORS.Accent
            executeButton.Text = "Execute Teleport"
        end
    else
        executeButton.BackgroundColor3 = COLORS.Red
        executeButton.Text = "Invalid Format (Need 3 or 12 numbers)"
        task.wait(1.5)
        executeButton.BackgroundColor3 = COLORS.Accent
        executeButton.Text = "Execute Teleport"
    end
end)

-- 14. MOVEMENT LOGIC & OVERRIDE CONTROL
local function getValue(text, default)
    local number = tonumber(text)
    if not number then return default end
    return math.clamp(number, 0, 500)
end

applyMovementButton.MouseButton1Click:Connect(function()
    speedValue = getValue(speedInput.Text, speedValue)
    jumpValue = getValue(jumpInput.Text, jumpValue)

    isOverriding = true
    
    local humanoid = getHumanoid()
    if humanoid then
        if nativeUseJumpPower then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = jumpValue
        else
            humanoid.UseJumpPower = false
            humanoid.JumpHeight = jumpValue
        end
        humanoid.WalkSpeed = speedValue
    end

    speedValueLabel.Text = tostring(speedValue)
    jumpValueLabel.Text = tostring(jumpValue)

    statusLabel.Text = "✓ Custom speed applied"
    statusLabel.TextColor3 = COLORS.Green
    applyMovementButton.Text = "Applied!"
    task.delay(1.2, function()
        if screenGui.Parent then
            applyMovementButton.Text = "Apply Stats"
        end
    end)
end)

resetMovementButton.MouseButton1Click:Connect(function()
    restoreNativeStats()

    speedInput.Text = tostring(nativeWalkSpeed)
    jumpInput.Text = tostring(nativeJumpVal)
    speedValueLabel.Text = tostring(nativeWalkSpeed)
    jumpValueLabel.Text = tostring(nativeJumpVal)

    statusLabel.Text = "↺ Restored game mechanics"
    statusLabel.TextColor3 = COLORS.Green
    resetMovementButton.Text = "Reset!"
    task.delay(1.2, function()
        if screenGui.Parent then
            resetMovementButton.Text = "Reset"
        end
    end)
end)

-- Reset override state if player respawns
player.CharacterAdded:Connect(function()
    isOverriding = false
end)

-- Main enforcement loop
task.spawn(function()
    while screenGui.Parent do
        task.wait(0.1)
        local humanoid = getHumanoid()
        if humanoid then
            if isOverriding then
                humanoid.WalkSpeed = speedValue
                if nativeUseJumpPower then
                    humanoid.UseJumpPower = true
                    humanoid.JumpPower = jumpValue
                else
                    humanoid.UseJumpPower = false
                    humanoid.JumpHeight = jumpValue
                end
            else
                speedValueLabel.Text = tostring(humanoid.WalkSpeed)
                jumpValueLabel.Text = tostring(nativeUseJumpPower and humanoid.JumpPower or humanoid.JumpHeight)
            end
        end
    end
end)

