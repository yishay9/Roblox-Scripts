--// SETTINGS & NATIVE STAT RECOVERY
local isOverriding = false

-- Safe default fallbacks
local nativeWalkSpeed = 16
local nativeJumpVal = 50
local nativeUseJumpPower = true

-- Safely derive native stats from StarterPlayer & current Humanoid
pcall(function()
    nativeWalkSpeed = StarterPlayer.CharacterWalkSpeed
end)

local currentHum = getHumanoid()
if currentHum then
    nativeUseJumpPower = currentHum.UseJumpPower
    if nativeUseJumpPower then
        nativeJumpVal = currentHum.JumpPower
    else
        nativeJumpVal = currentHum.JumpHeight
    end
    if not nativeWalkSpeed or nativeWalkSpeed == 0 then
        nativeWalkSpeed = currentHum.WalkSpeed
    end
end

local speedValue = nativeWalkSpeed
local jumpValue = nativeJumpVal

-- Helper function to restore original stats to humanoid
local function restoreNativeStats()
    isOverriding = false
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.WalkSpeed = nativeWalkSpeed
        if nativeUseJumpPower then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = nativeJumpVal
        else
            humanoid.UseJumpPower = false
            humanoid.JumpHeight = nativeJumpVal
        end
    end
end

_G.YishayHubRevertStats = restoreNativeStats

